# ──────────────────────────────────────────────────────────────
# Fraud Detection Gateway — Environment Configuration
# Copy this file to .env and fill in your values.
# ──────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# ── Redis ────────────────────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=fdg:

# ── PostgreSQL ───────────────────────────────────────────────
PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=fdg_admin
PG_PASSWORD=changeme
PG_DATABASE=fraud_gateway
PG_POOL_MIN=2
PG_POOL_MAX=10

# ── Risk Engine Thresholds ───────────────────────────────────
RISK_THRESHOLD_BLOCK=80
RISK_THRESHOLD_WARN=50

# ── Rate Limiting (Token Bucket) ─────────────────────────────
RATE_LIMIT_MAX_TOKENS=100
RATE_LIMIT_REFILL_RATE=10
RATE_LIMIT_REFILL_INTERVAL_MS=1000
RATE_LIMIT_WINDOW_MS=60000

# ── Geo-Shift Detection ─────────────────────────────────────
GEO_SHIFT_MAX_SPEED_KMH=1000
GEO_SHIFT_WINDOW_MS=300000

# ── Payload Rules ────────────────────────────────────────────
MAX_PAYLOAD_SIZE_BYTES=1048576

# ── Proxy / Upstream Target ─────────────────────────────────
UPSTREAM_TARGET=http://localhost:4000

# ── Fail Mode (open | secure) ───────────────────────────────
# open  = allow traffic if Redis/PG is down
# secure = block traffic if Redis/PG is down
FAIL_MODE=open
